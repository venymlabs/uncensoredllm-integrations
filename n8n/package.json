{
	"name": "n8n-nodes-uncensoredllm",
	"version": "0.1.0",
	"description": "n8n nodes for UncensoredLLM: a chat model for AI Agent workflows and a node that calls the API directly.",
	"license": "MIT",
	"homepage": "https://uncensoredllm.xyz/docs/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"uncensoredllm",
		"llm",
		"chat model",
		"openai-compatible"
	],
	"author": {
		"name": "UncensoredLLM"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/venymlabs/uncensoredllm-integrations.git",
		"directory": "n8n"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"aiNodeSdkVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/UncensoredLlmApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/LmChatUncensoredLlm/LmChatUncensoredLlm.node.js",
			"dist/nodes/UncensoredLlm/UncensoredLlm.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.57.4",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*",
		"@n8n/ai-node-sdk": "*"
	}
}
